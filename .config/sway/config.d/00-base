# Config writen with Remontoire in mind
## <category> // <action> // <keybinding> ## <reserved for user notes>

# setting modifier key for float actions (move/resize)
set $mod Mod4
floating_modifier $mod
workspace_auto_back_and_forth yes
# mouse_warping all?? (valid: output(default) none)
focus_on_window_activation none
focus_follows_mouse yes

# workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws0 "10:Audio"
set $gws "11:Game"

# background
set $resetmode           mode "default"

# (vim) directions
set $left  h
set $down  j
set $up    k
set $right l

# fix for neo layer 4
set $left2  Mod3+Left
set $down2  Mod3+Down
set $up2    Mod3+Up
set $right2 Mod3+Right
set $1      Mod3+KP_1
set $2      Mod3+KP_2
set $3      Mod3+KP_3
set $4      Mod3+KP_4
set $5      Mod3+KP_5
set $6      Mod3+KP_6
set $7      Mod3+KP_7
set $8      Mod3+KP_8
set $9      Mod3+KP_9
set $0      Mod3+KP_0
set $return Mod3+Return

# assign default output
workspace $ws1 output DP-1
workspace $ws0 output DP-2
workspace $gws output DP-1
